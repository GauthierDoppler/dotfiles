#!/bin/bash
# Modal fuzzy tmux session switcher, meant to be run inside `display-popup -E`.
#
#   j / k     move down / up
#   h / l     cycle the highlighted session's current window (preview follows)
#   Enter     switch to the highlighted session
#   Tab       toggle: this project's sessions  <->  all sessions
#   i         start filtering by name
#   Esc       leave search if searching, otherwise close
#   q         close (navigation only — in search it is a plain character)
#   Ctrl-x    kill the highlighted session and keep picking
#
# Search is OFF by default. With a handful of sessions, navigating beats typing,
# so j/k are movement keys and only `i` hands the keyboard to the query.
#
# ─── Preview ────────────────────────────────────────────────
# The preview shows the highlighted session's window list plus a live capture of
# its CURRENT window — not a window you pick inside the preview, because fzf
# previews cannot be focused. h/l instead run `previous-window`/`next-window` on
# the *other* session, which works fine while it is detached: the current window
# is session state and needs no attached client. So the "which window am I
# looking at" cursor is not tracked here at all — it is tmux's own, which is why
# there is no index to clamp per session and nothing to reset when the highlight
# moves.
#
# The trade is that h/l MUTATE that session: cycle past a window and Esc out, and
# you will land there next time you attach. That is the intended behaviour —
# lining up the window you want before pressing Enter is the point.
#
# capture-pane returns lines at the SOURCE pane's width, which is usually far
# wider than this popup, hence `nowrap`: truncating a full-screen TUI reads, while
# wrapping it does not.
#
# Esc is a single binding that branches on $FZF_INPUT_STATE (enabled/disabled/
# hidden). Do NOT implement this with `unbind(esc)`: fzf's unbind REMOVES a key's
# behaviour rather than restoring its default, so unbinding esc makes it inert.
# Combined with `q` being unbound during search, that left no way out of the
# popup at all except ctrl-c.
#
# The test is POSIX `[` on purpose: fzf runs these with `$SHELL -c`, falling back
# to `sh -c`, so bash's `[[` is not guaranteed to be available.
#
# ─── Project scoping ────────────────────────────────────────
# Grove names sessions "{prefix}{project}_{branch}_{key}" where {key} is a
# per-repo hash — FNV-1a32 of the absolute repo root path, low 16 bits, 4 hex
# chars — and is always the LAST field. It is identical for every branch and
# worktree of a repo, so "sessions of this project" == "same trailing key".
#
# Why the trailing key and not the leading "grove_<project>" prefix: grove's
# sanitizer is /[.\s:/@]/ -> '_' and leaves '_' alone. A repo named `my_repo`
# produces grove_my_repo_main_f2d1, where splitting on '_' from the left cannot
# separate project from branch. The trailing key has no such ambiguity.
#
# A session with no key (a hand-made name like `cctap`) belongs to no project,
# so it lists everything and Tab has nothing to toggle.
#
# Usage: tmux-sessions [--list] [--flip] [--prompt] [--header] [--preview <session>]
#                      [--next <session>] [--prev <session>]

set -uo pipefail

self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
scope_file="${TMPDIR:-/tmp}/tmux-sessions.scope"

# ─── Scope state ───────────────────────────────────────────
# Held in a file rather than in fzf, so `reload` subshells and the prompt/header
# helpers all observe the same value without depending on fzf internals.
scope_read()  { [ -r "$scope_file" ] && cat "$scope_file" || echo project; }
scope_write() { printf '%s' "$1" > "$scope_file"; }

current_session() { tmux display-message -p '#{session_name}' 2>/dev/null || true; }

# Trailing 4-hex grove repo key, or empty when the name is not grove-shaped.
# Requires two separators before the key so a short name like `my_a1b2` does not
# masquerade as a project.
session_key() {
  [[ "$1" =~ ^.+_.+_([0-9a-f]{4})$ ]] && printf '%s' "${BASH_REMATCH[1]}"
}

# ─── Listing ───────────────────────────────────────────────
list() {
  local scope current key rows width=0
  scope="$(scope_read)"
  current="$(current_session)"
  key="$(session_key "$current")"

  # No project to scope to -> always show everything.
  [ -z "$key" ] && scope=all

  rows=$(
    tmux list-sessions -F '#{session_last_attached}|#{session_name}|#{session_windows}|#{session_attached}' 2>/dev/null |
      sort -t'|' -k1,1nr |
      while IFS='|' read -r _ name windows attached; do
        [ "$name" = "$current" ] && continue
        if [ "$scope" = project ] && [ "${name##*_}" != "$key" ]; then
          continue
        fi
        printf '%s|%s|%s\n' "$name" "$windows" "$attached"
      done
  )
  [ -n "$rows" ] || return 0

  # Pad to the longest name actually present rather than a fixed width, so
  # alignment holds for both short names and long worktree names.
  while IFS='|' read -r name _ _; do
    [ "${#name}" -gt "$width" ] && width=${#name}
  done <<<"$rows"

  while IFS='|' read -r name windows attached; do
    if [ "${attached:-0}" != "0" ]; then
      printf "%-${width}s  %3s win  · attached\n" "$name" "$windows"
    else
      printf "%-${width}s  %3s win\n" "$name" "$windows"
    fi
  done <<<"$rows"
}

# ─── Preview ───────────────────────────────────────────────
# `-t <session>` with no window part resolves to the session's current window and
# its active pane, which is exactly the window the list above marks with ←.
# `-e` keeps the SGR sequences so a coloured TUI comes back looking like itself.
preview() {
  local name="$1"
  tmux list-windows -t "$name" \
    -F '#{window_index}: #{window_name}  (#{window_panes}p)#{?window_active, ←,}' 2>/dev/null
  printf '\n'
  tmux capture-pane -pe -t "$name" 2>/dev/null
}

# `no next window` on a single-window session is a failure exit, not a problem to
# report — h/l are movement keys and a session with one window simply cannot move.
cycle() {
  tmux "$1" -t "$2" 2>/dev/null || true
}

# ─── Labels ────────────────────────────────────────────────
prompt_label() {
  local key
  key="$(session_key "$(current_session)")"
  if [ -z "$key" ] || [ "$(scope_read)" = all ]; then
    printf '  all  '
  else
    printf '  project  '
  fi
}

# Two lines — navigation on top, actions below. One line no longer fits: the list
# side is roughly half of the popup, and `tab project only` pushed it past the
# width, where fzf truncates the tail (i.e. it silently ate `ctrl-x kill`).
header_label() {
  local key scope
  key="$(session_key "$(current_session)")"
  scope="$(scope_read)"
  if [ -z "$key" ]; then
    printf 'j/k move   h/l window   i search   (no project)\nenter switch   ctrl-x kill'
  elif [ "$scope" = all ]; then
    printf 'j/k move   h/l window   tab project only   i search\nenter switch   ctrl-x kill'
  else
    printf 'j/k move   h/l window   tab show all   i search\nenter switch   ctrl-x kill'
  fi
}

# ─── Helper modes (invoked by fzf bindings) ────────────────
case "${1:-}" in
  # Flips the scope and prints NOTHING. Flipping and rendering must not be split
  # across two fzf actions: `reload` runs its command asynchronously while
  # `transform-prompt` runs synchronously, so `reload(--flip)+transform-prompt`
  # renders the prompt from the scope file *before* the reload subprocess has
  # updated it — the list changes but the label shows the previous scope. The tab
  # binding calls this inside a single `transform`, which completes before any of
  # the actions it emits are run.
  --flip)
    if [ "$(scope_read)" = project ]; then scope_write all; else scope_write project; fi
    exit 0
    ;;
  --list)    list; exit 0 ;;
  --prompt)  prompt_label; exit 0 ;;
  --header)  header_label; exit 0 ;;
  --preview) preview "${2:-}"; exit 0 ;;
  --next)    cycle next-window "${2:-}"; exit 0 ;;
  --prev)    cycle previous-window "${2:-}"; exit 0 ;;
esac

# ─── Interactive ───────────────────────────────────────────
scope_write project   # deterministic default on every invocation

entries=$(list)
if [ -z "$entries" ]; then
  tmux display-message "  no other session"
  exit 0
fi

# fzf's default delimiter is whitespace, so {1} is the session name. Session
# names never contain spaces — grove replaces them with '_'.
selected=$(
  printf '%s\n' "$entries" | fzf \
    --disabled \
    --prompt="$(prompt_label)" \
    --header="$(header_label)" \
    --header-first \
    --pointer='▸' \
    --no-multi \
    --cycle \
    --bind 'j:down,k:up' \
    --bind 'q:abort' \
    --bind "l:execute-silent($self --next {1})+refresh-preview" \
    --bind "h:execute-silent($self --prev {1})+refresh-preview" \
    --bind 'i:enable-search+unbind(j,k,q,h,l)+change-prompt(  search  )' \
    --bind "esc:transform:[ \"\$FZF_INPUT_STATE\" = enabled ] && echo 'disable-search+clear-query+rebind(j,k,q,h,l)+transform-prompt($self --prompt)' || echo abort" \
    --bind "tab:transform:$self --flip; echo \"reload($self --list)+transform-prompt($self --prompt)+transform-header($self --header)+first\"" \
    --bind "ctrl-x:execute-silent(tmux kill-session -t {1})+reload($self --list)" \
    --preview="$self --preview {1}" \
    --preview-window='right,48%,border-left,nowrap'
) || exit 0

[ -n "$selected" ] || exit 0

tmux switch-client -t "${selected%% *}"
