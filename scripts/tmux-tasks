#!/bin/bash
# Modal fuzzy task runner for per-project scripts, meant to be run inside
# `display-popup -E`.
#
#   j / k     move down / up
#   Enter     run the highlighted task
#   Tab       cycle the group filter (all -> android -> ios -> ...)
#   i         start filtering by name
#   Ctrl-e    open the script in $EDITOR
#   Esc       leave search if searching, otherwise close
#   q         close (navigation only — in search it is a plain character)
#
# The interaction model is deliberately identical to `tmux-sessions`; see that
# file for why Esc branches on $FZF_INPUT_STATE instead of using fzf's
# `unbind(esc)`.
#
# The test is POSIX `[` on purpose: fzf runs bindings with `$SHELL -c`, falling
# back to `sh -c`, so bash's `[[` is not guaranteed to be available.
#
# ─── Where tasks come from ──────────────────────────────────
# `<root>/.tmux/` where <root> is the SESSION's working directory, never the
# pane's, so the picker resolves the same project from a pane three directories
# deep.
#
# A task is any *executable* regular file at depth 1 or 2 under .tmux/. The
# executable bit is the only filter, which is what keeps `.tmux/lib/common.sh`
# out of the list with no naming convention and no ignore file.
#
#   .tmux/android/build   -> task "android/build", group "android"
#   .tmux/doctor          -> task "doctor",        group ""  (ungrouped)
#
# ─── Header metadata ────────────────────────────────────────
# Read from the first 20 lines only, so scanning stays cheap:
#
#   # task: assemble the debug APK and install it
#   # tmux: window
#
# Placements: window (default) | split-down | split-right | popup | detach
#   `split` is an alias for split-down. Both splits take an optional size after
#   the placement — `split-right 40%`, `split-down 15` — defaulting to 30%.
#
# Both are optional. The reuse target for `window`/`detach` is derived from the
# task name ("android/build" -> window "android-build") rather than configured,
# so there is nothing to keep in sync.
#
# Usage: tmux-tasks [--check] [--list] [--advance] [--prompt] [--header] [--run <task>]
#
# --check exits 0 when this project has at least one task, so the tmux binding
# can gate the popup on it: a popup that opens and immediately exits reads as a
# flash.

set -uo pipefail

self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
runner="${self%/*}/tmux-task-run"

# ─── Project root ───────────────────────────────────────────
# `#{session_path}` is fixed at creation by `new-session -c` and, unlike
# pane_current_path, does not follow the shell.
session_root() {
  local root
  root="$(tmux display-message -p '#{session_path}' 2>/dev/null)"
  [ -n "$root" ] || root="$PWD"

  # Sessions created pointing at a subdirectory still resolve: walk up looking
  # for a .tmux/ directory, then give up and return the original.
  local dir="$root"
  while [ "$dir" != "/" ]; do
    [ -d "$dir/.tmux" ] && { printf '%s' "$dir"; return; }
    dir="$(dirname "$dir")"
  done
  printf '%s' "$root"
}

root="$(session_root)"
tasks_dir="$root/.tmux"

# ─── MRU state ──────────────────────────────────────────────
# Keyed by the project path so worktrees of the same repo share one history.
mru_file="${TMPDIR:-/tmp}/tmux-tasks.$(printf '%s' "$root" | cksum | cut -d' ' -f1)"
group_file="${TMPDIR:-/tmp}/tmux-tasks.group"

group_read()  { [ -r "$group_file" ] && cat "$group_file" || echo all; }
group_write() { printf '%s' "$1" > "$group_file"; }

mru_touch() {
  local name="$1" tmp
  tmp="$mru_file.tmp.$$"
  { printf '%s\n' "$name"; [ -r "$mru_file" ] && grep -vxF "$name" "$mru_file"; } > "$tmp" 2>/dev/null
  mv -f "$tmp" "$mru_file" 2>/dev/null
}

# ─── Discovery ──────────────────────────────────────────────
# -perm -u+x rather than -executable: BSD find (macOS) has no -executable.
discover() {
  [ -d "$tasks_dir" ] || return 0
  find "$tasks_dir" -mindepth 1 -maxdepth 2 -type f -perm -u+x 2>/dev/null |
    sed "s|^$tasks_dir/||" |
    grep -v '^\.' |
    sort
}

# Header value for a key, from the first 20 lines.
meta() {
  sed -n "1,20{s/^# *$2: *//p;}" "$tasks_dir/$1" 2>/dev/null | head -1
}

groups() {
  discover | awk -F/ 'NF>1 {print $1}' | sort -u
}

# ─── Listing ────────────────────────────────────────────────
list() {
  local group names name width=0 order
  group="$(group_read)"

  names="$(discover)"
  [ -n "$names" ] || return 0

  if [ "$group" != all ]; then
    names="$(printf '%s\n' "$names" | grep "^$group/")"
    [ -n "$names" ] || return 0
  fi

  # MRU first, then everything unseen in alphabetical order.
  if [ -r "$mru_file" ]; then
    order="$(
      while IFS= read -r name; do
        printf '%s\n' "$names" | grep -qxF "$name" && printf '%s\n' "$name"
      done < "$mru_file"
      printf '%s\n' "$names" | grep -vxF -f "$mru_file" 2>/dev/null
    )"
    [ -n "$order" ] && names="$order"
  fi

  while IFS= read -r name; do
    [ "${#name}" -gt "$width" ] && width=${#name}
  done <<<"$names"

  while IFS= read -r name; do
    [ -n "$name" ] || continue
    printf "%-${width}s  %s\n" "$name" "$(meta "$name" task)"
  done <<<"$names"
}

# ─── Labels ─────────────────────────────────────────────────
prompt_label() { printf '  %s  ' "$(group_read)"; }

header_label() {
  if [ -z "$(groups)" ]; then
    printf 'j/k move   enter run   i search   ctrl-e edit'
  else
    printf 'j/k move   enter run   tab group   i search   ctrl-e edit'
  fi
}

# Next group in the ring: all -> <groups in order> -> all
#
# This only WRITES the new group, it prints nothing. Advancing and rendering must
# not be split across two fzf actions: `reload` runs its command asynchronously
# while `transform-prompt` runs synchronously, so a `reload(--cycle)+transform-
# prompt(--prompt)` binding renders the prompt from the group file *before* the
# reload subprocess has updated it — the list moves but the label lags one step
# behind. The tab binding therefore calls `--advance` inside a single
# `transform`, which completes before any of the actions it emits are run.
cycle_group() {
  local current all next found=0
  current="$(group_read)"
  all="$(printf 'all\n%s\n' "$(groups)")"
  next="$(
    printf '%s\n' "$all" | while IFS= read -r g; do
      [ "$found" = 1 ] && { printf '%s' "$g"; break; }
      [ "$g" = "$current" ] && found=1
    done
  )"
  [ -n "$next" ] || next=all
  group_write "$next"
}

# ─── Running ────────────────────────────────────────────────
# run_task <name> [inline]
#
# `inline` is set by the interactive path, which is already running inside the
# `display-popup -E` opened by the tmux binding. tmux allows exactly ONE popup
# per client: a nested `display-popup` silently does nothing and still exits 0,
# so `popup` placement has to reuse the popup we are already in rather than ask
# for a second one. `split` and `new-window` have no such restriction and work
# untargeted from inside a popup.
run_task() {
  local name="$1" inline="${2:-0}" script placement size slug mark cmd
  script="$tasks_dir/$name"
  [ -x "$script" ] || { tmux display-message "  no such task: $name"; return 1; }

  # `# tmux:` may carry a size after the placement, e.g. `split-right 40%`.
  # Deliberately NOT named split-v/split-h: -v and -h mean opposite things in
  # tmux (-v = below) and vim (:vsplit = beside), so the direction is spelled out.
  placement="$(meta "$name" tmux)"
  size="${placement#* }"
  placement="${placement%% *}"
  [ "$size" = "$placement" ] && size=30%      # no second field -> default
  [ -n "$placement" ] || placement=window
  slug="$(printf '%s' "$name" | tr '/' '-')"

  mru_touch "$name"

  # mark=1 for the placements that OWN a window: those get @task_status plus a
  # bell and a macOS notification on completion. On a split or a popup the task
  # shares the window you are working in and the output is right in front of you.
  case "$placement" in
    window|detach) mark=1 ;;
    *)             mark=0 ;;
  esac
  cmd="exec $(printf '%q %q %q %q %q' "$runner" "$root" "$name" "$script" "$mark")"

  case "$placement" in
    popup)
      # Replacing this process runs the task in the popup that is already open,
      # which is the same result the user asked for — a floating window that
      # closes on a keypress — without a second popup tmux would refuse.
      if [ "$inline" = 1 ]; then exec "$runner" "$root" "$name" "$script" 0; fi
      tmux display-popup -E -w 80% -h 60% "$cmd"
      ;;
    split|split-down)
      tmux split-window -v -l "$size" -c "$root" "$cmd"
      ;;
    split-right)
      tmux split-window -h -l "$size" -c "$root" "$cmd"
      ;;
    detach)
      if tmux list-windows -F '#{window_name}' | grep -qxF "$slug"; then
        tmux respawn-window -k -t "$slug" -c "$root" "$cmd"
      else
        tmux new-window -d -n "$slug" -c "$root" "$cmd"
      fi
      ;;
    *)
      if tmux list-windows -F '#{window_name}' | grep -qxF "$slug"; then
        tmux respawn-window -k -t "$slug" -c "$root" "$cmd"
        tmux select-window -t "$slug"
      else
        tmux new-window -n "$slug" -c "$root" "$cmd"
      fi
      ;;
  esac
}

# ─── Helper modes (invoked by fzf bindings) ────────────────
case "${1:-}" in
  --check)   [ -d "$tasks_dir" ] && [ -n "$(discover)" ]; exit $? ;;
  --list)    list; exit 0 ;;
  --advance) cycle_group; exit 0 ;;
  --prompt) prompt_label; exit 0 ;;
  --header) header_label; exit 0 ;;
  --run)    run_task "${2:-}"; exit $? ;;
esac

# ─── Interactive ───────────────────────────────────────────
if [ ! -d "$tasks_dir" ]; then
  tmux display-message "  no .tmux/ tasks in $root"
  exit 0
fi

group_write all   # deterministic default on every invocation

entries=$(list)
if [ -z "$entries" ]; then
  tmux display-message "  no executable task in $tasks_dir"
  exit 0
fi

# fzf's default delimiter is whitespace, so {1} is the task name. Task names are
# file paths under .tmux/ and must not contain spaces.
# fzf SHELL-QUOTES placeholders before substituting them, so `{1}` must never sit
# inside quotes of our own: "$dir/{1}" expands to "$dir/'demo/detach'" and the
# quotes land in the path itself. Assigning it bare (`f={1}`) is the only safe
# form — fzf's quoting then does exactly what it is meant to do.
# shellcheck disable=SC2016  # $f and $d are expanded by fzf's preview shell, not here
preview='f={1}; d="'"$tasks_dir"'"; if command -v bat >/dev/null 2>&1; then bat --color=always --style=plain --line-range=:200 "$d/$f"; else cat "$d/$f"; fi'

selected=$(
  printf '%s\n' "$entries" | fzf \
    --disabled \
    --prompt="$(prompt_label)" \
    --header="$(header_label)" \
    --header-first \
    --pointer='▸' \
    --no-multi \
    --cycle \
    --bind 'j:down,k:up' \
    --bind 'q:abort' \
    --bind 'i:enable-search+unbind(j,k,q)+change-prompt(  search  )' \
    --bind "esc:transform:[ \"\$FZF_INPUT_STATE\" = enabled ] && echo 'disable-search+clear-query+rebind(j,k,q)+transform-prompt($self --prompt)' || echo abort" \
    --bind "tab:transform:$self --advance; echo \"reload($self --list)+transform-prompt($self --prompt)+transform-header($self --header)+first\"" \
    --bind "ctrl-e:execute(f={1}; \${EDITOR:-vi} '$tasks_dir'/\"\$f\")" \
    --preview="$preview" \
    --preview-window='right,55%,border-left'
) || exit 0

[ -n "$selected" ] || exit 0

run_task "${selected%% *}" 1
