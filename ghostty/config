# ─── Keybinds ──────────────────────────────────────────────
keybind = option+tab=goto_split:next
keybind = option+shift+tab=goto_split:previous
keybind = option+shift+r=prompt_surface_title
# Fix Shift+Enter to send proper escape sequence for tmux
keybind = shift+enter=text:\x1b[13;2u

# ─── Notifications ─────────────────────────────────────────
# Bell: bounce dock icon + badge (no system notification to avoid noise)
bell-features = title,attention
# Desktop notifications (OSC 9/777 — Claude Code completion, etc.)
desktop-notifications = true

# ─── Appearance ────────────────────────────────────────────
# Explicit Nerd Font. Without this, font-family is empty and Ghostty falls back
# to its built-in font, where every powerline separator and icon renders as a
# blank cell — which is why the tmux status bar looked like unstyled text and
# why nvim/init.lua still had have_nerd_font = false. The font is already
# installed in ~/Library/Fonts (Nerd Fonts 3.4.0).
font-family = JetBrainsMono Nerd Font Mono

theme = Catppuccin Frappe
unfocused-split-opacity = 0.55
