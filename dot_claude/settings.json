{
  "mcp": [],
  "alwaysThinkingEnabled": true,
  "cleanupPeriodDays": 90,
  "editorMode": "normal",
  "effortLevel": "medium",
  "enabledPlugins": {
    "playground@claude-plugins-official": true
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.local/bin/atelier\" hook claude 2>/dev/null || true",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.local/bin/atelier\" hook claude 2>/dev/null || true",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.local/bin/atelier\" hook claude 2>/dev/null || true",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "preferredNotifChannel": "notifications_disabled",
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "~/.claude/statusline-custom.sh",
    "padding": 0,
    "type": "command"
  },
  "tui": "default"
}
