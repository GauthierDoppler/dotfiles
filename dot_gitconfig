# This is Git's per-user configuration file.
[user]
#Please adapt and uncomment the following lines:
name = Gauthier Doppler
	email = gauthier.doppler@theodo.com
[push]
	autoSetupRemote = true
[alias]
	wt-add = "!f() { \\\n    branch=\"$1\"; \\\n    base=\"${2:-main}\"; \\\n    [ -z \"$branch\" ] && echo \"Usage: git wt-add <branch> [base]\" >&2 && return 1; \\\n    root=\"$(git rev-parse --show-toplevel)\"; \\\n    path=\"$root/worktrees/$branch\"; \\\n    git fetch origin \"$base\" >/dev/null 2>&1 || true; \\\n    git worktree add -b \"$branch\" \"$path\" \"$base\" >&2 || return 1; \\\n    echo \"$path\"; \\\n  }; f"
	unskip = "!f() {\n  for file in \"$@\"; do\n    if git ls-files --error-unmatch \"$file\" >/dev/null 2>&1; then\n      git update-index --no-skip-worktree \"$file\"\n      echo \"unskip-worktree: $file\"\n    else\n      exclude=\"$(git rev-parse --show-toplevel)/.git/info/exclude\"\n      escaped=$(printf \"%s\" \"$file\" | sed \"s/[\\/&]/\\\\\\\\&/g\")\n      sed -i \"\" \"/^${escaped}$/d\" \"$exclude\"\n      echo \"un-excluded: $file\"\n    fi\n  done\n}; f"
	skip = "!f() { \n  for file in \"$@\"; do\n    if git ls-files --error-unmatch \"$file\" >/dev/null 2>&1; then\n      git update-index --skip-worktree \"$file\"\n      echo \"skip-worktree: $file\"\n    else\n      echo \"$file\" >> \"$(git rev-parse --show-toplevel)/.git/info/exclude\"\n      echo \"excluded: $file\"\n    fi\n  done\n}; f"
	wt = "!f() { \\\n    branch=\"$1\"; \\\n    base=\"${2:-main}\"; \\\n    [ -z \"$branch\" ] && echo \"Usage: git wt <branch> [base]\" >&2 && return 1; \\\n    root=\"$(git rev-parse --show-toplevel)\"; \\\n    path=\"$root/worktrees/$branch\"; \\\n    git fetch origin \"$base\" >/dev/null 2>&1 || true; \\\n    git worktree add -b \"$branch\" \"$path\" \"$base\" >&2 || return 1; \\\n    echo \"$path\"; \\\n  }; f"
	wtl = worktree list
	wtc = "!f() { \\\n  branch=\"$1\"; \\\n  [ -z \"$branch\" ] && echo \"Usage: git wtc <branch>\" && return 1; \\\n  root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" || { echo \"❌ Not in a git repo\"; return 1; }; \\\n  cd \"$root/worktrees/$branch\" 2>/dev/null && pwd || echo \"❌ No worktree at $root/worktrees/$branch\"; \\\n}; f"
	wtr = "!f() { \\\n  branch=\"$1\"; \\\n  [ -z \"$branch\" ] && echo \"Usage: git wtr <branch>\" && return 1; \\\n  git worktree remove \"worktrees/$branch\"; \\\n}; f"
	wtp = worktree prune
	pull-safe = "!stashed=$(git stash); git pull; [ \"$stashed\" != \"No local changes to save\" ] && git stash pop"
	squash-merge = "!f() { \\\n    branch=\"${1:?Usage: git squash-merge <branch>}\"; \\\n    msg=\"$(echo \"$branch\" | sed 's/[-_]/ /g')\"; \\\n    git merge --squash \"$branch\" && git commit -e -m \"$msg\"; \\\n  }; f"
	pushall = push --recurse-submodules=on-demand
	sync = "!f() {\n  resolve() {\n  b=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null);\n  if [ -z \"$b\" ]; then\n    git remote set-head origin --auto >/dev/null 2>&1;\n    b=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null);\n  fi;\n  if [ -z \"$b\" ]; then\n    for c in main develop master; do\n      if git rev-parse --verify --quiet \"refs/remotes/origin/$c\" >/dev/null; then b=\"origin/$c\"; break; fi;\n    done;\n  fi;\n  [ -n \"$b\" ] || { echo \"no base branch found (origin/HEAD, main, develop, master)\" >&2; return 1; };\n  echo \"$b\";\n};\n  git fetch --prune || return 1;\n  base=$(resolve) || return 1;\n  echo \"rebasing onto $base\" >&2;\n  git rebase \"$base\";\n}; f"
	sync-safe = "!f() {\n  resolve() {\n  b=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null);\n  if [ -z \"$b\" ]; then\n    git remote set-head origin --auto >/dev/null 2>&1;\n    b=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null);\n  fi;\n  if [ -z \"$b\" ]; then\n    for c in main develop master; do\n      if git rev-parse --verify --quiet \"refs/remotes/origin/$c\" >/dev/null; then b=\"origin/$c\"; break; fi;\n    done;\n  fi;\n  [ -n \"$b\" ] || { echo \"no base branch found (origin/HEAD, main, develop, master)\" >&2; return 1; };\n  echo \"$b\";\n};\n  git fetch --prune || return 1;\n  base=$(resolve) || return 1;\n  stashed=$(git stash);\n  echo \"rebasing onto $base\" >&2;\n  git rebase \"$base\";\n  status=$?;\n  [ \"$stashed\" != \"No local changes to save\" ] && git stash pop;\n  return $status;\n}; f"
[include]
	path = ~/dotfiles/delta/themes.gitconfig
# No local include here: ~/.gitconfig is NOT a symlink to this file, it is a stub
# that includes it. Machine-specific keys live in ~/.gitconfig below that include
# — which is also where `git config --global` writes them. See install.sh (stub()).
