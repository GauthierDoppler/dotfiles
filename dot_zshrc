# ─── Homebrew ───────────────────────────────────────────────
if [[ -f /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# ─── Environment ───────────────────────────────────────────
export XDG_CONFIG_HOME="$HOME/.config"
export EDITOR='nvim'
export VISUAL='nvim'

# ─── Oh My Zsh ─────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(sudo command-not-found git colored-man-pages z docker docker-compose fnm node)

[[ -d "$ZSH" ]] && source "$ZSH/oh-my-zsh.sh"

# ─── fnm (Node version manager) ───────────────────────────
if command -v fnm &>/dev/null; then
  eval "$(fnm env --use-on-cd)"
fi

# ─── bun ───────────────────────────────────────────────────
if [[ -d "$HOME/.bun" ]]; then
  export BUN_INSTALL="$HOME/.bun"
  export PATH="$BUN_INSTALL/bin:$PATH"
  [[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"
fi

# ─── Ruby (keg-only, brew version over system) ────────────
if [[ -n "${HOMEBREW_PREFIX:-}" && -d "${HOMEBREW_PREFIX}/opt/ruby/bin" ]]; then
  export PATH="${HOMEBREW_PREFIX}/opt/ruby/bin:$PATH"
fi

# ─── libpq (keg-only, for Postgres projects) ──────────────
if [[ -n "${HOMEBREW_PREFIX:-}" && -d "${HOMEBREW_PREFIX}/opt/libpq" ]]; then
  export PATH="${HOMEBREW_PREFIX}/opt/libpq/bin:$PATH"
  export LDFLAGS="-L${HOMEBREW_PREFIX}/opt/libpq/lib"
  export CPPFLAGS="-I${HOMEBREW_PREFIX}/opt/libpq/include"
  export PKG_CONFIG_PATH="${HOMEBREW_PREFIX}/opt/libpq/lib/pkgconfig"
fi

# ─── PATH ──────────────────────────────────────────────────
[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"

# ─── Aliases ───────────────────────────────────────────────
n() { if [ "$#" -eq 0 ]; then command nvim .; else command nvim "$@"; fi; }
alias c="clear"
alias cl="claude"
alias "cl-yolo"="claude --dangerously-skip-permissions"
# Xcode already ships `xed` (`xed .`, `xed -l 42 File.swift`). Android Studio's
# launcher exists but is not on PATH. `open -a` hands the path to the running
# instance; the launcher binary would tie the IDE's lifetime to this shell.
if [[ -d "/Applications/Android Studio.app" ]]; then
  studio() { if [ "$#" -eq 0 ]; then open -a "Android Studio" .; else open -a "Android Studio" "$@"; fi; }
fi
# Le cheat sheet tmux vit dans dot_tmux.conf et s'affiche avec Prefix + ? —
# une seule source de vérité, lue directement depuis le fichier.

# ─── Project jump ──────────────────────────────────────────
typeset -gA _project_paths _project_names

project() {
  local name=$1 dir=${2:A} tab=${3:-$1}

  if [[ -z ${_project_paths[$name]} ]] && command -v "$name" &>/dev/null; then
    print -u2 "project: skipping '$name' — shadows an existing command"
    return 1
  fi
  [[ -d $dir ]] || return 0

  _project_paths[$name]=$dir
  _project_names[$name]=$tab
  eval "$name() { _project_jump ${(q)name} }"
}

_project_jump() {
  local dir=${_project_paths[$1]} tab=${_project_names[$1]}

  cd -- "$dir" || return

  # tmux's passthrough wrapper requires every ESC of the inner sequence doubled.
  if [[ -n $TMUX ]]; then
    printf '\ePtmux;\e\e]2;%s\a\e\\' "$tab"
  else
    printf '\e]2;%s\a' "$tab"
  fi

  command -v grove &>/dev/null || return 0

  local root branch
  root=$(git -C "$dir" worktree list --porcelain 2>/dev/null | head -1)
  root=${root#worktree }
  [[ -n $root ]] || return 0

  branch=$(git -C "$root" branch --show-current)
  if [[ -z $branch ]]; then
    branch=$(git -C "$root" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
    branch=${branch#origin/}
  fi
  [[ -n $branch ]] || return 0

  grove attach "$branch"
}

# ─── Optional sources ─────────────────────────────────────
[[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"

