# ─── Locale ────────────────────────────────────────────────
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# ─── Java (Gradle / Kotlin / Android) ─────────────────────
if [[ -x /usr/libexec/java_home ]]; then
  _java_home="$(/usr/libexec/java_home 2>/dev/null)"
  [[ -n "$_java_home" ]] && export JAVA_HOME="$_java_home"
  unset _java_home
fi

# ─── Android SDK ───────────────────────────────────────────
if [[ -d "$HOME/Library/Android/sdk" ]]; then
  export ANDROID_HOME="$HOME/Library/Android/sdk"
  export ANDROID_SDK_ROOT="$ANDROID_HOME"
  export PATH="$PATH:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$ANDROID_HOME/cmdline-tools/latest/bin"
fi

# ─── Machine-specific config ──────────────────────────────
# There is nothing to source here. ~/.zprofile is NOT a symlink to this file: it
# is a small stub that sources it, so anything a machine adds — by hand or by an
# installer appending to ~/.zprofile — lands below that line, outside this repo.
# Put local overrides straight into ~/.zprofile. See install.sh (stub()).
